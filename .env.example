# 复制本文件为 `.env` 或 `.env.development` 后按需修改
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# 开发环境后端地址（Nuxt 会把浏览器请求 /url/** 代理到这里）
# 须指向可用的业务后端，否则登录、案例列表等接口会失败
NUXT_PROXY_TARGET=http://127.0.0.1:8080

# 生产环境建议填写固定 CDN 域名，多个域名使用英文逗号分隔，支持 *.example.com
# NUXT_MEDIA_PROXY_ALLOWED_HOSTS=aid.oss-cn-hangzhou.aliyuncs.com

# 分镜脚本 / 视频 / 配音：0=走真实接口（默认），1=本地模拟进度（无后端联调时可用）
NUXT_PUBLIC_MOCK_STEP4_PLUS_GEN=0

# 可选：低分辨率视口缩放，0=关闭（也可在页面右下角开关）
# NUXT_PUBLIC_VIEWPORT_COMPACT_SCALE=0
